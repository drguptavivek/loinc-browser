# LOINC Browser listen address. CLI --addr or --port overrides this.
LOINC_BROWSER_ADDR=:9005

# Alternative for platforms that provide PORT.
# PORT=9005

# Unix domain socket transport (Mode D), off by default. Serves the same
# handler as LOINC_BROWSER_ADDR over a local socket file.
# LOINC_BROWSER_UNIX_SOCKET=./data/loinc-browser.sock

# UDP micro-protocol listener (Mode E), off by default
# LOINC_BROWSER_UDP_ADDR=

# Editable Markdown docs served by the MCP agent resources.
LOINC_AGENT_DOCS_DIR=./docs/agent

# Official LOINC Search API proxy. Credentials can be entered in the UI and
# optionally saved encrypted in the local file-backed KV store.
LOINC_OFFICIAL_API_BASE_URL=https://loinc.regenstrief.org/searchapi
LOINC_APP_KEY_PATH=./data/loinc-browser-app.key
LOINC_KV_PATH=./data/loinc-browser-kv.json

# Generated local Lucene-style search index.
LOINC_SEARCH_INDEX_PATH=./data/loinc-search.bleve

# Optional data files (defaults shown). The Top 2000 mapper's guide CSV adds
# exampleUcum/mapperComment to term results.
# LOINC_MAPPER_GUIDE_CSV=./data/common_codes/top2000_mapper_guide.csv

# Optional common-codes list: any CSV with a LOINC code column and a name column.
# Its codes rank first and carry localName. Precedence: LOINC_COMMON_CODES_CSV,
# then LOINC_CLCI_CSV, then Common Lab Codes for India found in the data dir.
# LOINC_COMMON_CODES_CSV=./data/common_codes/my-lab-list.csv
# LOINC_COMMON_CODES_LABEL=My Hospital Lab List
# LOINC_CLCI_CSV=./data/common-lab-codes-for-india-20260629/common-lab-codes-for-india.csv

# Agentic search (docs/API.md "Agentic search"): an OpenAI-compatible chat/completions
# endpoint the in-app agent calls with the read-only LOINC MCP tools. Off until a base URL and
# model are set here or saved via PUT /api/v1/agent/settings (UI-saved values win).
# LOINC_AGENT_DISABLED=false
# LOINC_AGENT_LLM_BASE_URL=http://127.0.0.1:1234/v1
# LOINC_AGENT_LLM_MODEL=qwen3-8b
# LOINC_AGENT_LLM_API_KEY=
# Refuses a non-loopback/private base URL unless set to false.
# LOINC_AGENT_LLM_LOCAL_ONLY=true
# Default reasoning/thinking switch; a chat request may override it per call.
# LOINC_AGENT_LLM_THINKING=false
